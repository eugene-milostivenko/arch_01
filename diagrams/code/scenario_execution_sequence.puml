@startuml
title Scenario Execution — Code (Sequence) Diagram

autonumber
skinparam sequenceMessageAlign center

actor "Automation\nTrigger / Scheduler" as Trigger

box "Automation Executor Service" #F7F9FC
  participant "ExecutionHandler"        as Handler
  participant "ScenarioReader"          as Reader
  participant "ScenarioExecutor"        as Executor
  participant "CommandDispatcher"       as Dispatcher
  participant "ExecutionLogRepository"  as LogRepo
end box

database  "Automation DB"             as DB
participant "Device Management\nService" as Device
queue     "Event Queue (Kafka)"      as Queue

Trigger -> Handler : HandleExecution(ExecutionRequest)
activate Handler

Handler -> Reader : GetScenario(scenarioID)
activate Reader
Reader -> DB : SELECT scenario + steps
DB --> Reader : rows
Reader --> Handler : Scenario
deactivate Reader

Handler -> Executor : Execute(scenario, source)
activate Executor

Executor -> LogRepo : Create(log, status=RUNNING)
LogRepo -> DB : INSERT execution_log

loop for each ScenarioStep (ordered)
  alt condition not met
    Executor -> Executor : skip step
  else condition met
    Executor -> Dispatcher : Dispatch(DeviceCommand)
    activate Dispatcher
    Dispatcher -> Device : SendCommand(cmd)\nREST (HTTP)
    activate Device
    Device --> Dispatcher : CommandAck
    deactivate Device
    Dispatcher --> Executor : StepResult
    deactivate Dispatcher
  end
  Executor -> LogRepo : append StepResult
  opt step.DelayMs > 0
    Executor -> Executor : wait(DelayMs)
  end
end

Executor -> LogRepo : Update(log, status=SUCCESS / PARTIAL / FAILURE)
LogRepo -> DB : UPDATE execution_log

Executor -> Queue : Publish(ExecutionResultEvent)

Executor --> Handler : ExecutionResult
deactivate Executor
Handler --> Trigger : ExecutionResult
deactivate Handler

@enduml
