@startuml
title Automation Executor Service — Code (Class) Diagram

skinparam classAttributeIconSize 0
hide empty members

' ── Entry point ───────────────────────────────────────────────────────────────
class ExecutionHandler {
  - reader   : RuleReader
  - executor : RuleExecutor
  + HandleExecution(req: ExecutionRequest) : AutomationExecution
}

' ── Reads the rule and its actions from the DB ─────────────────────────────────
class RuleReader {
  - repo : RuleRepository
  + GetRule(id: RuleID) : AutomationRule
}

' ── Orchestrates ordered execution of the rule's actions ───────────────────────
class RuleExecutor {
  - dispatcher : CommandDispatcher
  - execRepo   : ExecutionRepository
  - publisher  : EventPublisher
  + Execute(rule: AutomationRule, triggerID: TriggerID) : AutomationExecution
  - runAction(action: AutomationAction) : CommandAck
}

' ── Translates a rule action into a concrete device command ────────────────────
class CommandDispatcher {
  - deviceClient : DeviceClient
  + Dispatch(action: AutomationAction) : CommandAck
}

' ── Ports (Go interfaces) ───────────────────────────────────────────────────────
interface RuleRepository {
  + FindByID(id: RuleID) : AutomationRule
}
interface ExecutionRepository {
  + Create(exec: AutomationExecution) : void
  + Update(exec: AutomationExecution) : void
}
interface DeviceClient {
  + SendCommand(cmd: DeviceCommand) : CommandAck
}
interface EventPublisher {
  + Publish(event: ExecutionResultEvent) : void
}

' ── Domain entities (aligned with Automation Management API and ER) ─────────────
class AutomationRule {
  + ID       : RuleID
  + HouseID  : UUID
  + Name     : string
  + IsActive : bool
  + Triggers : AutomationTrigger[]
  + Actions  : AutomationAction[]
}
class AutomationTrigger {
  + ID          : TriggerID
  + TriggerType : TriggerType
  + Condition   : map
}
class AutomationAction {
  + ID         : UUID
  + DeviceID   : UUID
  + Command    : string
  + Parameters : map
  + Order      : int
}
class DeviceCommand {
  + DeviceID   : UUID
  + Command    : string
  + Parameters : map
}
class CommandAck {
  + CommandID : UUID
  + Status    : CommandStatus
}
class AutomationExecution {
  + ID         : UUID
  + RuleID     : RuleID
  + TriggerID  : TriggerID
  + Status     : ExecutionStatus
  + StartedAt  : time
  + FinishedAt : time
}
class ExecutionRequest {
  + RuleID    : RuleID
  + TriggerID : TriggerID
}
class ExecutionResultEvent {
  + RuleID      : RuleID
  + ExecutionID : UUID
  + Status      : ExecutionStatus
  + FinishedAt  : time
}

enum ExecutionStatus {
  RUNNING
  SUCCESS
  PARTIAL
  FAILURE
}
enum CommandStatus {
  DISPATCHED
  DELIVERED
  FAILED
}
enum TriggerType {
  TELEMETRY_THRESHOLD
  SCHEDULE
  DEVICE_STATE_CHANGE
}

' ── Composition / usage relations ──────────────────────────────────────────────
ExecutionHandler   --> RuleReader           : uses
ExecutionHandler   --> RuleExecutor          : uses
RuleReader         ..> RuleRepository        : reads via
RuleExecutor       --> CommandDispatcher      : dispatches actions
RuleExecutor       ..> ExecutionRepository    : persists via
RuleExecutor       ..> EventPublisher         : publishes via
CommandDispatcher  ..> DeviceClient           : sends via

AutomationRule "1" *-- "many" AutomationAction
AutomationRule "1" *-- "many" AutomationTrigger

CommandDispatcher  ..> DeviceCommand          : creates
CommandDispatcher  ..> CommandAck             : returns
RuleReader         ..> AutomationRule         : returns
RuleExecutor       ..> AutomationExecution    : builds
RuleExecutor       ..> ExecutionResultEvent   : builds
ExecutionHandler   ..> ExecutionRequest       : accepts

AutomationExecution --> ExecutionStatus
CommandAck          --> CommandStatus
AutomationTrigger   --> TriggerType

@enduml
