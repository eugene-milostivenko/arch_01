@startuml
title WarmHouse ER Diagram

' ── User Management ───────────────────────────────────────────────────────────
entity "User" as user {
  * id : UUID <<PK>>
  --
  * email : VARCHAR
  * name : VARCHAR
  * password_hash : VARCHAR
  * created_at : TIMESTAMP
  * updated_at : TIMESTAMP
}

entity "Session" as session {
  * id : UUID <<PK>>
  --
  * user_id : UUID <<FK>>
  * token_hash : VARCHAR
  * expires_at : TIMESTAMP
  * created_at : TIMESTAMP
}

' ── Device Management ─────────────────────────────────────────────────────────
entity "House" as house {
  * id : UUID <<PK>>
  --
  * owner_id : UUID <<FK>>
  * name : VARCHAR
  * address : VARCHAR
  * created_at : TIMESTAMP
  * updated_at : TIMESTAMP
}

entity "UserHouseAccess" as house_access {
  * id : UUID <<PK>>
  --
  * user_id : UUID <<FK>>
  * house_id : UUID <<FK>>
  * role : VARCHAR
  * granted_at : TIMESTAMP
  * updated_at : TIMESTAMP
}

entity "DeviceType" as device_type {
  * id : UUID <<PK>>
  --
  * name : VARCHAR
  * vendor_name : VARCHAR
  * updated_at : TIMESTAMP
}

entity "Module" as module {
  * id : UUID <<PK>>
  --
  * house_id : UUID <<FK>>
  * name : VARCHAR
  * created_at : TIMESTAMP
  * updated_at : TIMESTAMP
}

entity "Device" as device {
  * id : UUID <<PK>>
  --
  * type_id : UUID <<FK>>
  * module_id : UUID <<FK>>
  * serial_number : VARCHAR
  * name : VARCHAR
  * status : VARCHAR
  * installed_at : TIMESTAMP
  * updated_at : TIMESTAMP
}

entity "DeviceCommand" as command {
  * id : UUID <<PK>>
  --
  * device_id : UUID <<FK>>
  * issued_by : UUID <<FK>>
  * command : VARCHAR
  * parameters : JSONB
  * status : VARCHAR
  * issued_at : TIMESTAMP
}

' ── Telemetry ─────────────────────────────────────────────────────────────────
entity "TelemetryData" as telemetry {
  * id : UUID <<PK>>
  --
  * device_id : UUID <<FK>>
  * metric_name : VARCHAR
  * value : FLOAT
  * unit : VARCHAR
  * recorded_at : TIMESTAMP
}

' ── Automation ────────────────────────────────────────────────────────────────
entity "Scenario" as scenario {
  * id : UUID <<PK>>
  --
  * house_id : UUID <<FK>>
  * created_by : UUID <<FK>>
  * name : VARCHAR
  * is_active : BOOLEAN
  * created_at : TIMESTAMP
  * updated_at : TIMESTAMP
}

entity "ScenarioTrigger" as trigger {
  * id : UUID <<PK>>
  --
  * scenario_id : UUID <<FK>>
  * trigger_type : VARCHAR
  * condition : JSONB
  * updated_at : TIMESTAMP
}

entity "ScenarioStep" as step {
  * id : UUID <<PK>>
  --
  * scenario_id : UUID <<FK>>
  * device_id : UUID <<FK>>
  * command : VARCHAR
  * order : INTEGER
  * updated_at : TIMESTAMP
}

entity "ScenarioExecution" as execution {
  * id : UUID <<PK>>
  --
  * scenario_id : UUID <<FK>>
  * trigger_id : UUID <<FK>>
  * status : VARCHAR
  * started_at : TIMESTAMP
  * finished_at : TIMESTAMP
}

' ── Relations ─────────────────────────────────────────────────────────────────
user        ||--o{ session      : "authenticates via"
user        ||--o{ house        : "owns"
user        ||--o{ house_access : "has access via"
house       ||--o{ house_access : "accessed by"
house       ||--o{ module    : "has"
module      ||--o{ device    : "contains"
house       ||--o{ scenario  : "has"
user        ||--o{ scenario  : "creates"
device_type ||--o{ device    : "typed as"
device      ||--o{ telemetry : "generates"
device      ||--o{ command   : "receives"
scenario    ||--o{ trigger   : "fired by"
scenario    ||--o{ step      : "consists of"
scenario    ||--o{ execution : "logged in"
trigger     ||--o{ execution : "fires"
device      ||--o{ step      : "targeted by"
user        ||--o{ command   : "issues"

@enduml