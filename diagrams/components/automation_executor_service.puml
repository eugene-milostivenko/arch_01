@startuml
title Automation Executor Service — Component Diagram
top to bottom direction
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

' ── External containers ───────────────────────────────────────────────────────
Container_Ext(AutomationTriggerSvc,    "Automation Trigger Service",    "Go",        "Triggers execution on condition match")
Container_Ext(AutomationSchedulerSvc,  "Automation Scheduler Service",  "Go",        "Triggers execution on schedule")
Container_Ext(DeviceManagementSvc,     "Device Management Service",     "Go",        "Owns device domain. Routes commands to the correct vendor.")
Container_Ext(EventQueue,              "Event Queue",                   "Kafka",     "System event bus")
ContainerDb_Ext(AutomationDb,          "Automation Database",           "PostgreSQL","Automation rules, triggers, actions and execution log")

' ── Automation Executor Service boundary ─────────────────────────────────────
Container_Boundary(AutomationExecutorService, "Automation Executor Service") {

  Component(ExecutionHandler,    "Execution Handler",     "Go",            "Entry point. Accepts execution requests from Trigger and Scheduler services. Validates and initiates execution.")
  Component(RuleReader,          "Rule Reader",           "Go",            "Reads the automation rule and its ordered actions from AutomationDb.")
  Component(RuleExecutor,        "Rule Executor",         "Go",            "Orchestrates ordered execution of the rule's actions and derives the overall execution result.")
  Component(CommandDispatcher,   "Command Dispatcher",    "Go",            "Translates a rule action into a concrete device command. Delegates delivery to Device Management Service.")
  Component(ExecutionRepository, "Execution Repository",  "Go",            "Persists execution records: rule, trigger, start / finish time, overall status (success / partial / failure).")
}

' ── Relations: inbound ───────────────────────────────────────────────────────
Rel(AutomationTriggerSvc,   ExecutionHandler, "Requests execution", "HTTP / gRPC")
Rel(AutomationSchedulerSvc, ExecutionHandler, "Requests execution", "HTTP / gRPC")

' ── Relations: internal ──────────────────────────────────────────────────────
Rel(ExecutionHandler,  RuleReader,           "Fetches rule definition")
Rel(ExecutionHandler,  RuleExecutor,         "Starts rule execution")

Rel(RuleExecutor,  CommandDispatcher,       "Dispatches each action as a command")
Rel(RuleExecutor,  ExecutionRepository,     "Writes execution result")

Rel(CommandDispatcher, DeviceManagementSvc,  "Sends device commands",   "REST (HTTP)")

' ── Relations: outbound ──────────────────────────────────────────────────────
Rel(RuleReader,            AutomationDb,  "Reads rule actions",      "SQL")
Rel(ExecutionRepository,   AutomationDb,  "Writes execution record", "SQL")
Rel(RuleExecutor,          EventQueue,    "Publishes execution result events")

@enduml
